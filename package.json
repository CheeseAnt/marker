{
  "name": "marker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-static-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-static-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:preview": "npm run build && playwright test --config playwright.preview.config.ts",
    "eval": "vitest run --config vitest.evals.config.ts",
    "eval:live": "MARKER_EVAL_LIVE=1 vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
